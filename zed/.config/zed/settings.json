// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // extensions the theme/icon_theme below depend on; installed on startup (html is Zed's default)
  "auto_install_extensions": {
    "html": true,
    "dark-glass-theme": true,
    "colored-zed-icons-theme": true,
    "catppuccin-icons": true,
  },
  "cursor_animation": {
    "enabled": true
  },
  "language_models": {
    "llama.cpp": {
      "api_url": "http://100.125.140.95:8080"
    }
  },
  "disable_ai": false,
  "proxy": "",
  "mouse_wheel_zoom": false,
  "code_lens": "menu",
  "cli_default_open_behavior": "existing_window",
  "current_line_highlight": "all",
  "rounded_selection": true,
  "unnecessary_code_fade": 0.3,
  "cursor_shape": "bar",
  "zoomed_padding": true,
  "active_pane_modifiers": {
    "inactive_opacity": 1.0,
  },
  "use_system_window_tabs": true,
  "focus_follows_mouse": {
    "enabled": false,
  },
  "centered_layout": {
    "right_padding": 0.2,
    "left_padding": null,
  },
  "bottom_dock_layout": "contained",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "terminal": {
    "font_weight": 100.0,
    // nushell on the XDG-layout Mac (XDG_DATA_HOME set), login shell elsewhere
    "shell": {
      "with_arguments": {
        "program": "/bin/sh",
        "args": ["-c", "[ -n \"$XDG_DATA_HOME\" ] && command -v nu >/dev/null && exec nu || exec \"${SHELL:-/bin/zsh}\" -l"],
      },
    },
    "button": true,
  },
  "agent_buffer_font_size": 16.0,
  "agent_ui_font_size": 16.0,
  "ui_font_weight": 350.0,
  "buffer_font_weight": 100.0,
  "diff_view_style": "split",
  "git_panel": {
    "group_by": "staging",
    "sort_by": "path",
    "dock": "left",
    "tree_view": true,
  },
  "colorize_brackets": true,
  "helix_mode": false,
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager",
  },
  "agent": {
    "show_turn_stats": false,
    "button": true,
    "flexible": true,
    "sidebar_side": "right",
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "default_profile": "ask",
    "default_model": {
      "provider": "llama.cpp",
      "model": "Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF:Q4_K_M",
    },
    "model_parameters": [],
  },
  "ssh_connections": [
    {
      "host": "github.com",
      "args": [],
      "projects": []
    },
    {
      "host": "100.125.140.95",
      "username": "error",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/error"
          ]
        }
      ]
    }
  ],
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16.0,
  "buffer_font_size": 16.0,
  "buffer_line_height": {
    "custom": 1.5,
  },
  "buffer_font_features": { "calt": true },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Transparent Prism",
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
    "show": true,
    "show_nav_history_buttons": true,
    "show_tab_bar_buttons": true,
  },
  "preview_tabs": { "enabled": true },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "tabs": {
    "show_close_button": "hover",
    "show_diagnostics": "errors",
    "close_position": "right",
    "git_status": true,
    "file_icons": true,
  },
  "ui_font_family": "Monaspace Krypton",
  "buffer_font_family": "Monaspace Krypton",
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
}
