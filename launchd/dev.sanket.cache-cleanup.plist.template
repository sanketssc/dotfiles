<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.sanket.cache-cleanup</string>
	<!-- trims bazel / gradle / go / npm / xcode / metro caches; stale worktrees are only reported -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/.local/bin/cache-cleanup.sh</string>
		<string>--apply</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__HOME__</string>
	<!-- every 3h; a run missed while asleep fires once on wake -->
	<key>StartInterval</key>
	<integer>10800</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/cache-cleanup.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/cache-cleanup.log</string>
</dict>
</plist>
