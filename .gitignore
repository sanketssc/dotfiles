# macOS junk
.DS_Store
# local config backups
*.bak.*
# karabiner writes these on every change
karabiner/.config/karabiner/automatic_backups/
# herdr runtime state (only config.toml + local-plugins are tracked)
herdr/.config/herdr/*
!herdr/.config/herdr/config.toml
!herdr/.config/herdr/local-plugins/
# zed runtime data (config files are tracked)
zed/.config/zed/prompts/
zed/.config/zed/conversations/
zed/.config/zed/settings_backup.json
# git: per-machine overrides
git/.config/git/config.local
# kitty: per-machine overrides
kitty/.config/kitty/local.conf
# worktrunk: per-machine hook approvals (~/.config/worktrunk is folded into this package)
worktrunk/.config/worktrunk/approvals.toml
# nushell runtime files (the config dir is linked into this repo on the XDG layout)
nushell/.config/nushell/history.*
nushell/.config/nushell/plugin.msgpackz
