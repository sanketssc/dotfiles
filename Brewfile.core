# Core setup for a new Mac: terminal + editor + herdr/Collie + Claude + nushell.
# Used by `./install.sh --core` (brew bundle --file Brewfile.core).

tap "oven-sh/bun"

# shell + prompt
brew "nushell"
brew "starship"
brew "zoxide"
brew "atuin"

# terminal + editor
brew "tmux"
brew "neovim"
brew "lazygit"
brew "yazi"
brew "fzf"
brew "ripgrep"
brew "fd"
brew "bat"
brew "eza"
brew "jq"

# git + dotfiles
brew "git"
brew "gh"
brew "stow"

# herdr + Collie (Collie's plugin build needs bun + git; herdr-agent-usage builds with cargo)
brew "herdr"
brew "oven-sh/bun/bun"
brew "rust"
brew "tailscale"

# Claude (node for `npx skills`)
brew "node"
cask "claude-code"

# terminal app + fonts
cask "kitty"
cask "font-monaspace"
cask "font-jetbrains-mono-nerd-font"   # starship prompt glyphs

# workflow tools
brew "worktrunk"        # wt — git worktrees
brew "jj"               # jujutsu (starship shows jj state)
brew "tree-sitter-cli"  # nvim treesitter parser builds
brew "coreutils"
brew "btop"
brew "gdu"
brew "wget"
brew "tree"
brew "uv"

# matiks dev stack
# Go is NOT installed from brew: the monorepo pins it (and lefthook, mockery, gofumpt,
# golangci-lint, grpcurl) in mise.toml — run `task tools:install` inside the repo.
# A brew `go` on PATH ahead of mise's pin breaks the pre-push hook (see its Taskfile).
brew "mise"
brew "go-task"
brew "bazelisk"         # fetches the Bazel version pinned in .bazelversion
brew "buf"
brew "redis"
brew "watch"
brew "cocoapods"
brew "openjdk@17"
brew "xcodegen"
brew "awscli"
cask "docker-desktop"
cask "gcloud-cli"
cask "android-studio"

# apps
cask "raycast"
cask "brave-browser"
cask "slack"
cask "clickup"
cask "zed"
cask "mongodb-compass"
cask "localsend"
