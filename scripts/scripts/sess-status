#!/bin/sh
# sess-status — set a master session's status tag, shown in the herdr sidebar in front of its title:
#   ◐ m1-p feed-links
#   sess-status <p|w|d> [pane]      pane defaults to $HERDR_PANE_ID
#   p = in progress (master working or a dispatched session still running)
#   w = waiting on the user (reply or decision)
#   d = done (topic finished, nothing pending)
# Masters are herdr agents named m<N>-<topic>. The tag is pane metadata (token mtag = m<N>-<s>), so
# nothing is ever typed into the session. No-op for sessions that are not masters.
set -eu
herdr=${HERDR_BIN_PATH:-herdr}
case ${1:-} in p | w | d) s=$1 ;; *) sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;; esac
pane=${2:-${HERDR_PANE_ID:-}}
[ -n "$pane" ] || exit 0
name=$("$herdr" agent get "$pane" 2>/dev/null | jq -r '.result.agent.name // empty') || exit 0
role=$(printf '%s\n' "$name" | sed -nE 's/^(m[0-9]+)-.+$/\1/p')
[ -n "$role" ] || exit 0
# Names from the earlier format carried the letter (m1-p-topic): drop it.
plain=$(printf '%s\n' "$name" | sed -E 's/^(m[0-9]+)-[pwd]-(.+)$/\1-\2/')
[ "$plain" = "$name" ] || "$herdr" agent rename "$pane" "$plain" >/dev/null
"$herdr" pane report-metadata "$pane" --source matiks-master --token "mtag=$role-$s" >/dev/null
echo "$pane -> $role-$s ${plain#*-}"
