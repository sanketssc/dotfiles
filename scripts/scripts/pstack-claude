#!/usr/bin/env -S python3 -I
"""pstack-claude: port Cursor's pstack plugin to Claude Code and install it.

Fetches pstack from github.com/cursor/plugins, rewrites what Claude Code reads
differently, adds a Claude Code adapter (tool and model names, a lean delegation
budget, a per-prompt reminder hook) and installs or updates the result as the
plugin pstack@pstack-local. Rerun it to pick up upstream changes.

  pstack-claude              fetch upstream main, build, install or update
  pstack-claude --ref REF    build an upstream branch, tag or commit
  pstack-claude --build      build only; leave Claude's plugin list alone

Set PSTACK_AUTO=off in the environment to silence the per-prompt reminder.
"""

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

UPSTREAM_URL = "https://github.com/cursor/plugins.git"
MARKETPLACE = "pstack-local"
PLUGIN = "pstack"

DATA = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "pstack-claude"
UPSTREAM = DATA / "upstream"
MARKET = DATA / "marketplace"

# Skills Claude may load on its own. Every other skill stays manual-only so its
# description never enters a session's context; poteto-mode reads them by path.
MODEL_INVOCABLE = {"poteto-mode"}

POTETO_DESCRIPTION = (
    "Rigorous engineering mode from pstack (poteto): playbooks, principles, verified work"
    " and clean replies. Use at the start of any non-trivial engineering task (bug fix,"
    " feature, refactor, perf, investigation, PR babysit or ship, multi-step or unattended"
    " work), for /poteto-mode, or when asked to work in poteto's style. Skip quick"
    " questions and casual turns."
)

# Cursor-only frontmatter keys. Claude Code ignores or rejects them.
CURSOR_KEYS = ("mode", "icon", "color", "reminder", "is_background")

POINTER = (
    "> **Claude Code port.** Before you follow this skill, read"
    " `${CLAUDE_SKILL_DIR}/../../CLAUDE-CODE.md` once per session. It maps Cursor tool"
    " and model names to Claude Code, says how to open other pstack skills, and sets the"
    " delegation budget. Where it disagrees with this skill, it wins.\n"
)

AGENT_NOTE = {
    "poteto-agent": (
        "\n## Claude Code\n\nLoad `poteto-mode` with the Skill tool (`pstack:poteto-mode`)."
        " It points you at `CLAUDE-CODE.md`, which maps Cursor names and sets the delegation"
        " budget. Read principle and skill files by path as it describes.\n"
    ),
}

AGENT_MODEL = {"poteto-agent": "sonnet", "comment-sicko": "sonnet"}

REMINDER = (
    "pstack auto-mode is on. Before your first tool call, decide whether this prompt starts"
    " an engineering task that matches a pstack playbook: bug fix, feature, refactor, perf,"
    " investigation, prototype, PR babysit or ship, multi-step or unattended work. If it does"
    " and pstack:poteto-mode is not loaded in this session, call the Skill tool with"
    " pstack:poteto-mode first and follow it. Skip it only for a question you can answer in a"
    " few tool calls without changing code, a casual turn, a fix of one obvious line, or when"
    " the user opts out.\n"
)

# Cursor terms the adapter does not cover. The build warns when upstream adds one.
UNMAPPED = re.compile(r"\.cursor/(?!rules/pstack-models|skills|plugins|projects|worktrees)")

ADAPTER = """\
# pstack on Claude Code

pstack was written for Cursor. This file maps it to Claude Code. Read it once per session before you follow any pstack skill. Where this file and a pstack skill disagree, this file wins. Where the user's global instructions (CLAUDE.md or AGENTS.md) disagree with either, the global instructions win.

The pstack root is the folder that holds this file. Skills are at `<root>/skills/<name>/SKILL.md` and agents at `<root>/agents/<name>.md`.

## Opening pstack skills

Only `poteto-mode` loads through the Skill tool (`pstack:poteto-mode`). Every other pstack skill and every principle is manual-only, which keeps its description out of each session's context. When a pstack file names another skill ("the how skill", "principle-fix-root-causes"), a playbook (`playbooks/bug-fix.md`) or a reference (`references/rubric.md`), open the file with the Read tool. Do not call the Skill tool for them, because it refuses manual-only skills. The user can still type `/pstack:<name>`.

## Names

| pstack says (Cursor) | In Claude Code |
|---|---|
| `Task` tool, Task call, spawn | Agent tool |
| `subagent_type: "poteto-agent"` | `pstack:poteto-agent` |
| `subagent_type: "comment-sicko"` | `pstack:comment-sicko` |
| `generalPurpose` | `general-purpose`, or `Explore` when the spawn is read-only |
| `readonly: true` | the `Explore` agent, or "read-only, no edits" in the brief |
| `run_in_background: true` | the default; pass `false` only when your next step needs the result |
| `AskQuestion` | AskUserQuestion |
| todo list | your task or todo list tool |
| plan mode | EnterPlanMode |
| `/loop` | the `loop` skill |
| `/create-skill`, Cursor's create-skill | the `write-a-skill` skill |
| `/deslop`, the deslop skill (cursor-team-kit) | an inline cleanup pass on the diff: reuse, dead code, needless layers, slop comments |
| `control-cli` | drive the CLI or TUI with Bash |
| `control-ui` | argent tools (iOS, Android, Chromium); T3 preview tools inside T3 Code |
| Cursor's built-in babysit | the babysit playbook with `gh`; inside T3 Code also `watch_pull_request` |
| Bugbot, agentic security review | any review bot or app that comments on the PR; same skeptical triage |
| cloud agent URL | a T3 thread or a transcript path |
| Cursor restart | a session restart or context compaction |
| `~/.cursor/rules/pstack-models.mdc`, `/setup-pstack` | the Models table below; `/setup-pstack` does not apply |
| `agent-transcripts/` folder, `~/.cursor/projects/<slug>/agent-transcripts/` | `$CLAUDE_CONFIG_DIR/projects/<slug>/` (default `~/.claude/projects/`). `<slug>` is the working directory with every `/` and `.` turned into `-`. This session's transcript is the newest `*.jsonl` there. Never read other projects' folders. |
| `.cursor/skills/`, `~/.cursor/skills/`, `~/.cursor/plugins/` | `.claude/skills/`, `$CLAUDE_CONFIG_DIR/skills/`, `$CLAUDE_CONFIG_DIR/plugins/` |
| other `.cursor/` paths inside a repo | `.claude/` |

## Models

The Agent tool's `model` takes `haiku`, `sonnet`, `opus` or `fable`. Map Cursor slugs by role, not by name.

| Role (pstack-models line) | Model |
|---|---|
| feature, refactoring; bug-fix; perf-issue; hillclimb (code delegates) | sonnet |
| hardest tasks; judgment and prose | opus |
| how explorer; why investigators; swarm workers; reflect tooling | sonnet |
| how explainer; why synthesizer | no agent; the main thread does it |
| reflect judgment, divergent, synthesizer | opus |
| arena runners; arena cross-judge pool; architect runners; interrogate reviewers | opus, sonnet |
| pure locate (where is X, list the uses of Y) | haiku |

Any other slug follows its family. `grok-*`, `composer-*`, `gpt-*` and `gemini-*` mean sonnet. `claude-opus-*` means opus. Drop effort suffixes such as `-xhigh` and `-fast`. "A second opinion from a different model" means opus against sonnet. Use another provider (Codex through T3 Code's `delegate_task`) only when the user asks.

## Delegation budget

A subagent loads its own system prompt, tools and files before it does any work, so each spawn costs thousands of tokens. A spawn pays off only when it keeps a large raw payload out of the main thread or buys an independent check. Work inline by default.

When poteto-mode routed you to a step or skill (the user did not name it), spawn only in these cases:

1. **Bulk read.** The answer needs many files (about 8 or more) or long raw output (logs, transcripts, wide searches) that the main thread does not need word for word. Use one `Explore` agent on sonnet, or haiku for a pure locate. Brief it with paths and cap the reply, for example "under 300 words, file:line references".
2. **Independent review before a PR or merge** of a non-trivial diff: roughly 150 or more changed lines, or code that touches concurrency, data, auth or money. Use one reviewer on opus with the interrogate rubric. Use a two-model panel (opus, sonnet) only for high-stakes or irreversible changes.
3. **Large independent units in parallel.** Three or more units, each spanning several files, with no shared files. Use one sonnet agent per unit, at most 4. First check whether a script or codemod does the job instead (principle-build-the-lever).

Everything else runs inline.

- **how and why.** Explore and explain inline. Use rule 1 for the bulk read only. For why, one agent may sweep several MCP sources; synthesize inline.
- **architect.** Sketch once inline: types, signatures, module shape. Use parallel runners only for a novel architecture with real stakes, at most 2.
- **interrogate.** Rule 2.
- **no-comments.** Apply Comment Sicko's rules (`<root>/agents/comment-sicko.md`) yourself. Spawn `pstack:comment-sicko` only for a diff over about 300 lines.
- **arena, swarm, reflect, review panels and other fan-out.** Only when the user asks.
- **Code playbooks** (feature, refactoring, bug fix, perf, hillclimb). The main thread writes the code. Delegate only under rule 3.
- **Second opinions and "a fresh subagent per round".** Rule 2 only.

When the user types a pstack slash command (`/pstack:interrogate`, `/pstack:swarm`) or asks for agents, run that skill as written with the models above. When you do spawn, use `pstack:poteto-agent` for delegates that write code and `Explore` for read-only work. Brief with file paths rather than pasted content, and state the reply cap.

## Where the user's global instructions change pstack

- **Outward-facing actions.** Team chat, tickets, PR comments, pushing, opening PRs and deploys need the user's go-ahead unless they already asked for that action. poteto-mode's "Just do it" covers local, reversible work only.
- **Git and PRs.** Follow the global git rules. Commit messages carry no `Co-Authored-By` or `Claude-Session` lines. The Opening a PR playbook prepares the commits and the PR body; push and open the PR only when the user asked for it.
- **Reply style.** When caveman mode is active, it sets the sentence form of chat replies. poteto-mode's content rules still hold: name the principles that changed a decision, frame impact for the consumer and the maintainer, and never fabricate a link. Apply unslop to persisted prose (docs, PR bodies, commit messages), not to caveman chat replies.
"""


def run(*cmd, cwd=None, check=True, capture=False):
    result = subprocess.run(
        cmd, cwd=cwd, check=False, text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
    )
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip() if capture else ""
        sys.exit("pstack-claude: '{}' failed. {}".format(" ".join(cmd), detail))
    return result


def fetch(ref):
    if not (UPSTREAM / ".git").is_dir():
        if UPSTREAM.exists():
            shutil.rmtree(UPSTREAM)
        UPSTREAM.parent.mkdir(parents=True, exist_ok=True)
        run("git", "clone", "-q", "--depth", "1", "--filter=blob:none", "--sparse",
            "--no-checkout", UPSTREAM_URL, str(UPSTREAM))
        run("git", "-C", str(UPSTREAM), "sparse-checkout", "set", "pstack")
    run("git", "-C", str(UPSTREAM), "fetch", "-q", "--depth", "1", "origin", ref)
    run("git", "-C", str(UPSTREAM), "checkout", "-q", "--detach", "FETCH_HEAD")
    sha = run("git", "-C", str(UPSTREAM), "rev-parse", "--short=7", "HEAD", capture=True)
    return sha.stdout.strip()


def split_frontmatter(text):
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return None, text
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            return lines[1:i], "\n".join(lines[i + 1:])
    return None, text


def drop_key(fm, key):
    """Remove a top-level key and its indented continuation lines."""
    out, skipping = [], False
    for line in fm:
        if re.match(r"^{}\s*:".format(re.escape(key)), line):
            skipping = True
            continue
        if skipping and (line.startswith((" ", "\t")) or not line.strip()):
            continue
        skipping = False
        out.append(line)
    return out


def set_key(fm, key, value):
    fm = drop_key(fm, key)
    return ["{}: {}".format(key, json.dumps(value, ensure_ascii=False))] + fm


def port_skill(path):
    name = path.parent.name
    fm, body = split_frontmatter(path.read_text())
    if fm is None:
        sys.exit("pstack-claude: {} has no frontmatter".format(path))
    for key in CURSOR_KEYS:
        fm = drop_key(fm, key)
    if name in MODEL_INVOCABLE:
        fm = drop_key(fm, "disable-model-invocation")
        fm = set_key(fm, "description", POTETO_DESCRIPTION)
    elif not any(re.match(r"^disable-model-invocation\s*:", line) for line in fm):
        fm.append("disable-model-invocation: true")
    if name.startswith("principle-"):
        fm = set_key(fm, "user-invocable", False)
    fm = set_key(fm, "name", name)
    if not name.startswith("principle-"):
        body = "\n" + POINTER + body
    path.write_text("---\n" + "\n".join(fm) + "\n---\n" + body)


def port_agent(path):
    name = path.stem
    fm, body = split_frontmatter(path.read_text())
    if fm is None:
        sys.exit("pstack-claude: {} has no frontmatter".format(path))
    for key in CURSOR_KEYS:
        fm = drop_key(fm, key)
    if name in AGENT_MODEL and not any(l.startswith("model:") for l in fm):
        fm.append("model: " + AGENT_MODEL[name])
    path.write_text("---\n" + "\n".join(fm) + "\n---\n" + body.rstrip("\n") + "\n"
                    + AGENT_NOTE.get(name, ""))


def build(sha):
    src = UPSTREAM / "pstack"
    upstream_meta = json.loads((src / "plugin.json").read_text())
    stage = DATA / "marketplace.new"
    if stage.exists():
        shutil.rmtree(stage)
    plugin = stage / PLUGIN

    shutil.copytree(src / "skills", plugin / "skills")
    shutil.copytree(src / "agents", plugin / "agents")
    shutil.copytree(src / "docs", plugin / "docs", ignore=shutil.ignore_patterns("images"))
    for name in ("README.md", "LICENSE"):
        shutil.copy2(src / name, plugin / name)

    skills = sorted(plugin.glob("skills/*/SKILL.md"))
    for path in skills:
        port_skill(path)
    for path in sorted(plugin.glob("agents/*.md")):
        port_agent(path)

    (plugin / "CLAUDE-CODE.md").write_text(ADAPTER)
    hooks = plugin / "hooks"
    hooks.mkdir()
    (hooks / "reminder.txt").write_text(REMINDER)
    (hooks / "hooks.json").write_text(json.dumps({"hooks": {"UserPromptSubmit": [{"hooks": [{
        "type": "command",
        "command": '[ "${PSTACK_AUTO:-on}" = off ] || cat "${CLAUDE_PLUGIN_ROOT}/hooks/reminder.txt"',
        "timeout": 5,
    }]}]}}, indent=2) + "\n")

    # The version changes whenever upstream or this script changes, so
    # `claude plugin update` sees a new build.
    script_hash = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()[:6]
    version = "{}-cc.{}.{}".format(upstream_meta["version"], sha, script_hash)
    meta = {k: upstream_meta[k] for k in ("name", "description", "author", "homepage",
                                          "repository", "license", "keywords") if k in upstream_meta}
    meta["version"] = version
    meta["description"] += " Claude Code port built by pstack-claude."
    (plugin / ".claude-plugin").mkdir()
    (plugin / ".claude-plugin/plugin.json").write_text(json.dumps(meta, indent=2) + "\n")
    (stage / ".claude-plugin").mkdir()
    (stage / ".claude-plugin/marketplace.json").write_text(json.dumps({
        "name": MARKETPLACE,
        "description": "Local Claude Code port of Cursor's pstack plugin.",
        "owner": {"name": "pstack-claude"},
        "plugins": [{"name": PLUGIN, "source": "./" + PLUGIN, "version": version,
                     "description": meta["description"]}],
    }, indent=2) + "\n")

    for path in sorted(list(plugin.glob("skills/**/*.md")) + list(plugin.glob("agents/*.md"))):
        for n, line in enumerate(path.read_text().split("\n"), 1):
            if UNMAPPED.search(line):
                print("warn: unmapped Cursor term at {}:{}".format(path.relative_to(plugin), n))

    if MARKET.exists():
        shutil.rmtree(MARKET)
    stage.rename(MARKET)
    print("built {} {} ({} skills) in {}".format(PLUGIN, version, len(skills), MARKET), flush=True)
    return version


def install():
    if not shutil.which("claude"):
        sys.exit("pstack-claude: claude is not on PATH")
    run("claude", "plugin", "validate", str(MARKET))
    known = run("claude", "plugin", "marketplace", "list", capture=True).stdout
    if MARKETPLACE in known:
        run("claude", "plugin", "marketplace", "update", MARKETPLACE)
    else:
        run("claude", "plugin", "marketplace", "add", str(MARKET))
    installed = run("claude", "plugin", "list", capture=True).stdout
    if "{}@{}".format(PLUGIN, MARKETPLACE) in installed:
        run("claude", "plugin", "update", "{}@{}".format(PLUGIN, MARKETPLACE))
    else:
        run("claude", "plugin", "install", "{}@{}".format(PLUGIN, MARKETPLACE))
    print("installed {}@{}. New Claude sessions pick it up.".format(PLUGIN, MARKETPLACE))


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--ref", default="main", help="upstream branch, tag or commit")
    parser.add_argument("--build", action="store_true", help="build only, do not install")
    args = parser.parse_args()
    build(fetch(args.ref))
    if not args.build:
        install()


if __name__ == "__main__":
    main()
