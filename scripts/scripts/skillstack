# Skills whose text spawns sub-agents. The note puts them under pstack's budget.
MATT_SPAWNERS = {"code-review", "codebase-design", "grilling", "research", "improve-codebase-architecture"}

MATT_BUDGET_NOTE = (
    "> **skillstack:** Spawn sub-agents in this skill only within pstack's delegation budget"
    " (the skill router in this session's context): work inline by default, use one agent for"
    " a bulk read, one reviewer covering both axes for a diff over about 150 lines or a risky"
