)

SKILL_REF = re.compile(r"""(["`])([a-z0-9-]+)\1""")

# --- karpathy ----------------------------------------------------------------

KARPATHY_PLUGIN = "karpathy"
KARPATHY_DESCRIPTION = (
    "Karpathy's four coding rules: think before coding, simplicity first, surgical changes,"
    " goal-driven execution. Use when writing, reviewing or refactoring code, and to check a"
    " diff for overcomplication or edits beyond the request."
)

# --- skillstack (router hooks) ----------------------------------------------

ROUTER_PLUGIN = "skillstack"

ROUTER = """\
# Skill router (skillstack)

Three skill sets are installed: `pstack` (poteto's engineering playbooks), `mattpocock` (Matt Pocock's skills) and `karpathy` (Karpathy's coding guidelines). Use them without waiting for the user to name one. The user's global instructions (CLAUDE.md, AGENTS.md) win over this router, and this router wins over any skill.

## Baseline for every code change

These rules hold for every edit, one-line fixes included. The full text is the `karpathy:karpathy-guidelines` skill.

1. **Think first.** State your assumptions. When a request has two readings, name both. Settle facts by reading or running code. Ask the user only for product or preference calls; otherwise take the sensible default, say which, and proceed.
2. **Simplicity first.** Write the least code that solves the problem. Add no unrequested features, options or abstractions.
3. **Surgical changes.** Touch only what the task needs and match the local style. Remove only the orphans your change created; mention other dead code.
4. **Goal-driven.** Turn the task into a check (a test, a command, an observed output) and loop until it passes.

## Which skill to load

Before your first tool call on a prompt, match it against this table. Load each matching skill with the Skill tool unless it is already loaded in this session. Skip the table for quick questions, casual turns and one-line fixes.

| Situation | Skill |
|---|---|
| Any code change beyond a one-line fix (feature, bug fix, refactor, perf), a multi-step investigation, a prototype, unattended work, PR babysit or ship | `pstack:poteto-mode`, the umbrella. It picks the playbook and the principles. |
| Hard bug: intermittent, a regression, a perf drop, or it resists a first look | also `mattpocock:diagnosing-bugs` |
| Writing or changing tests, test-first work, the user mentions TDD or asks to keep it tested | `mattpocock:tdd`. A bug's regression test follows pstack's tdd cadence in the bug-fix playbook. |
| A design question that throwaway code answers faster (state model, UI look) | `mattpocock:prototype` |
| Module shape, interface depth, seams, testability | `mattpocock:codebase-design` |
| Domain terms, GLOSSARY.md, ADRs | `mattpocock:domain-modeling` |
| How code works, where new code belongs | `pstack:how` |
| What a change could break | `pstack:blast-radius` |
| Review a branch, PR or diff | `mattpocock:code-review` |
| Write a PR body | `mattpocock:pr`; commits and titles follow pstack's Opening a PR rules |
| Docs, READMEs, RFCs, commit messages | `pstack:technical-writing` |
| Skills, CLAUDE.md, AGENTS.md | `mattpocock:writing-for-agents` |
| Report a speedup or regression you measured | `pstack:benchmark-checklist` |
| The user wants to plan or think a design through, or says "grill" | `mattpocock:grill-with-docs` in a repo, else `mattpocock:grilling`. In matiks repos use the matiks `grill-me` skill. |
| The user hands over a spec, ticket or issue to build | `mattpocock:implement` |
| The user asks for a spec or PRD, tickets, or issue triage | `mattpocock:to-spec`, `mattpocock:to-tickets`, `mattpocock:triage` |
| Steps only a human can do: dashboards, secrets, provisioning | `mattpocock:wizard` |
| Research a topic from primary sources | `mattpocock:research` |
| "Catch me up", "where did I leave off" | `pstack:recall` |
| The user asks for a handoff, a retro, a questionnaire for someone else, or to learn a concept | `mattpocock:handoff`, `mattpocock:retro`, `mattpocock:to-questionnaire`, `mattpocock:teach` |
| The user did not follow your last message | `mattpocock:wait-what` |

## When skills disagree

- **Sub-agents.** pstack's delegation budget decides every spawn, including the sub-agents that mattpocock skills describe. Work inline by default. Spawn one agent for a bulk read (about 8 or more files, or long raw output) and one reviewer for a diff over about 150 lines or one that touches concurrency, data, auth or money. Spawn parallel agents only for 3 or more large independent units, or when the user asks.
- **Asking the user.** For reversible work, decide, act and report. Where a skill says to confirm a choice with the user (tdd seams, a prototype branch), state your choice and continue; ask only when the call is the user's to make. Grilling is the exception: it runs only when the user asked to plan or be grilled, and its questions are the point.
- **Issue tracker.** Skills that publish specs, tickets or triage results read the tracker setup from the repo's CLAUDE.md or AGENTS.md. If there is none, tell the user to run `/mattpocock:setup-matt-pocock-skills`. Publishing to a tracker is outward-facing: do it only when the user asked for that result.
- **Same skill in two places.** A matiks-skills-hub skill wins inside matiks repos.
"""

NUDGE = (
    "skillstack: before your first tool call, decide which skills this prompt needs and load"
    " each one that is not loaded yet with the Skill tool. Any code change beyond a one-line"
    " fix (feature, bug fix, refactor, perf) or a multi-step investigation: pstack:poteto-mode."
    " Writing or changing tests: mattpocock:tdd. Reviewing a diff, branch or PR:"
    " mattpocock:code-review. Other situations: the skill router from session start. Skip"
    " skills only for a question you can answer without changing code, a casual turn, a"
    " one-line fix, or when the user opts out.\n"
)

HOOK_COMMAND = '[ "${{SKILLSTACK_AUTO:-on}}" = off ] || cat "${{CLAUDE_PLUGIN_ROOT}}/hooks/{}"'


def die(message):
    sys.exit("skillstack: " + message)


def run(*cmd, cwd=None, check=True, capture=False):
    result = subprocess.run(
        cmd, cwd=cwd, check=False, text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
    )
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip() if capture else ""
        die("'{}' failed. {}".format(" ".join(cmd), detail))
    return result


def fetch(name, ref):
    url, sparse = SOURCES[name]
    repo = UPSTREAM / name
    if not (repo / ".git").is_dir():
        if repo.exists():
            shutil.rmtree(repo)
        repo.parent.mkdir(parents=True, exist_ok=True)
        clone = ["git", "clone", "-q", "--depth", "1", "--filter=blob:none", "--no-checkout"]
        if sparse:
            clone.append("--sparse")
        run(*clone, url, str(repo))
        if sparse:
            run("git", "-C", str(repo), "sparse-checkout", "set", *sparse)
    run("git", "-C", str(repo), "fetch", "-q", "--depth", "1", "origin", ref)
    run("git", "-C", str(repo), "checkout", "-q", "--detach", "FETCH_HEAD")
    sha = run("git", "-C", str(repo), "rev-parse", "--short=7", "HEAD", capture=True)
    return sha.stdout.strip()


def split_frontmatter(text):
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return None, text
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            return lines[1:i], "\n".join(lines[i + 1:])
    return None, text


def drop_key(fm, key):
    """Remove a top-level key and its indented continuation lines."""
    out, skipping = [], False
    for line in fm:
        if re.match(r"^{}\s*:".format(re.escape(key)), line):
            skipping = True
            continue
        if skipping and (line.startswith((" ", "\t")) or not line.strip()):
            continue
        skipping = False
        out.append(line)
    return out


def set_key(fm, key, value):
    fm = drop_key(fm, key)
    return ["{}: {}".format(key, json.dumps(value, ensure_ascii=False))] + fm


def has_key(fm, key):
    return any(re.match(r"^{}\s*:".format(re.escape(key)), line) for line in fm)


def read_skill(path):
    fm, body = split_frontmatter(path.read_text())
    if fm is None:
        die("{} has no frontmatter".format(path))
    return fm, body


def write_skill(path, fm, body):
    path.write_text("---\n" + "\n".join(fm) + "\n---\n" + body)


def write_manifest(plugin, meta):
    (plugin / ".claude-plugin").mkdir(parents=True, exist_ok=True)
    (plugin / ".claude-plugin/plugin.json").write_text(json.dumps(meta, indent=2) + "\n")


def port_pstack_skill(path):
    name = path.parent.name
    fm, body = read_skill(path)
    for key in CURSOR_KEYS:
        fm = drop_key(fm, key)
    if name in PSTACK_MODEL_INVOCABLE:
        fm = drop_key(fm, "disable-model-invocation")
        if name == "poteto-mode":
            fm = set_key(fm, "description", POTETO_DESCRIPTION)
    elif not has_key(fm, "disable-model-invocation"):
        fm.append("disable-model-invocation: true")
    if name.startswith("principle-"):
        fm = set_key(fm, "user-invocable", False)
    else:
        body = "\n" + PSTACK_POINTER + body
    write_skill(path, set_key(fm, "name", name), body)


def port_pstack_agent(path):
    name = path.stem
    fm, body = read_skill(path)
    for key in CURSOR_KEYS:
        fm = drop_key(fm, key)
    if name in AGENT_MODEL and not has_key(fm, "model"):
        fm.append("model: " + AGENT_MODEL[name])
    path.write_text("---\n" + "\n".join(fm) + "\n---\n" + body.rstrip("\n") + "\n"
                    + AGENT_NOTE.get(name, ""))


def build_pstack(stage, sha):
    src = UPSTREAM / "pstack" / "pstack"
    upstream_meta = json.loads((src / "plugin.json").read_text())
    plugin = stage / "pstack"
    shutil.copytree(src / "skills", plugin / "skills")
    shutil.copytree(src / "agents", plugin / "agents")
    shutil.copytree(src / "docs", plugin / "docs", ignore=shutil.ignore_patterns("images"))
    for name in ("README.md", "LICENSE"):
        shutil.copy2(src / name, plugin / name)

    skills = sorted(plugin.glob("skills/*/SKILL.md"))
    missing = PSTACK_MODEL_INVOCABLE - {p.parent.name for p in skills}
    if missing:
        die("pstack no longer has {}".format(", ".join(sorted(missing))))
    for path in skills:
        port_pstack_skill(path)
    for path in sorted(plugin.glob("agents/*.md")):
        port_pstack_agent(path)
    invocable = ", ".join("`{}`".format(n) for n in sorted(PSTACK_MODEL_INVOCABLE))
    (plugin / "CLAUDE-CODE.md").write_text(ADAPTER.replace("{invocable}", invocable))

    for path in sorted(list(plugin.glob("skills/**/*.md")) + list(plugin.glob("agents/*.md"))):
        for n, line in enumerate(path.read_text().split("\n"), 1):
            if UNMAPPED.search(line):
                print("warn: unmapped Cursor term at pstack/{}:{}".format(
                    path.relative_to(plugin), n))

    meta = {k: upstream_meta[k] for k in ("name", "description", "author", "homepage",
                                          "repository", "license", "keywords") if k in upstream_meta}
    meta["version"] = "{}-cc.{}.{}".format(upstream_meta["version"], sha, SCRIPT_HASH)
    meta["description"] += " Claude Code port built by skillstack."
    write_manifest(plugin, meta)
    return meta, len(skills)


def build_mattpocock(stage, sha):
    src = UPSTREAM / "mattpocock"
    upstream_meta = json.loads((src / ".claude-plugin/plugin.json").read_text())
    plugin = stage / MATT_PLUGIN
    dirs = {}
    for bucket in MATT_BUCKETS:
        for skill in sorted((src / "skills" / bucket).glob("*/SKILL.md")):
            name = skill.parent.name
            if name in dirs:
                die("mattpocock has two skills named {}".format(name))
            dirs[name] = bucket
            shutil.copytree(skill.parent, plugin / "skills" / name,
                            ignore=shutil.ignore_patterns("agents"))
    missing = (set(MATT_FLIP) | MATT_SPAWNERS) - set(dirs)
    if missing:
        die("mattpocock no longer has {}".format(", ".join(sorted(missing))))

    for name, bucket in dirs.items():
        path = plugin / "skills" / name / "SKILL.md"
        fm, body = read_skill(path)
        if name in MATT_FLIP:
            fm = drop_key(fm, "disable-model-invocation")
            fm = set_key(fm, "description", MATT_FLIP[name])
        elif bucket not in MATT_PROMOTED and not has_key(fm, "disable-model-invocation"):
            fm.append("disable-model-invocation: true")
        # "Call the Skill tool with "tdd"" names a sibling; qualify it with the plugin.
        body = "\n".join(
            SKILL_REF.sub(lambda m: m.group(0) if m.group(2) not in dirs
                          else "{0}{1}:{2}{0}".format(m.group(1), MATT_PLUGIN, m.group(2)), line)
            if "Skill tool" in line else line
            for line in body.split("\n"))
        if name in MATT_SPAWNERS:
            body = "\n" + MATT_BUDGET_NOTE + body
        write_skill(path, set_key(fm, "name", name), body)

    for name in ("README.md", "LICENSE"):
        shutil.copy2(src / name, plugin / name)
    meta = {k: upstream_meta[k] for k in ("description", "author", "homepage", "repository",
                                          "license", "keywords") if k in upstream_meta}
    meta = dict(name=MATT_PLUGIN, **meta)
    meta["version"] = "{}-cc.{}.{}".format(upstream_meta["version"], sha, SCRIPT_HASH)
    meta["description"] += " Claude Code build by skillstack."
    write_manifest(plugin, meta)
    return meta, len(dirs)


def build_karpathy(stage, sha):
    src = UPSTREAM / "karpathy"
    upstream_meta = json.loads((src / ".claude-plugin/plugin.json").read_text())
    plugin = stage / KARPATHY_PLUGIN
    skill = plugin / "skills/karpathy-guidelines"
    shutil.copytree(src / "skills/karpathy-guidelines", skill)
    shutil.copy2(src / "README.md", plugin / "README.md")
    fm, body = read_skill(skill / "SKILL.md")
    fm = set_key(fm, "description", KARPATHY_DESCRIPTION)
    body = body.rstrip("\n") + (
        "\n\nSource: github.com/forrestchang/andrej-karpathy-skills (MIT), built by skillstack.\n")
    write_skill(skill / "SKILL.md", fm, body)
    meta = {k: upstream_meta[k] for k in ("description", "author", "license", "keywords")
            if k in upstream_meta}
    meta = dict(name=KARPATHY_PLUGIN, **meta)
    meta["version"] = "{}-cc.{}.{}".format(upstream_meta["version"], sha, SCRIPT_HASH)
    meta["repository"] = "https://github.com/forrestchang/andrej-karpathy-skills"
    write_manifest(plugin, meta)
    return meta, 1


def build_router(stage):
    plugin = stage / ROUTER_PLUGIN
    hooks = plugin / "hooks"
    hooks.mkdir(parents=True)
    (hooks / "router.md").write_text(ROUTER)
    (hooks / "nudge.txt").write_text(NUDGE)

    def hook(file):
        return [{"hooks": [{"type": "command", "command": HOOK_COMMAND.format(file),
                            "timeout": 5}]}]

    (hooks / "hooks.json").write_text(json.dumps({"hooks": {
        "SessionStart": hook("router.md"),
        "UserPromptSubmit": hook("nudge.txt"),
    }}, indent=2) + "\n")
    meta = {
        "name": ROUTER_PLUGIN,
        "description": "Routes Claude to the pstack, mattpocock and karpathy skills without"
                       " slash commands: a skill router at session start and a nudge per prompt.",
        "version": "1.0.0-cc.{}".format(SCRIPT_HASH),
        "author": {"name": "skillstack"},
    }
    write_manifest(plugin, meta)
    return meta, 0


def build(shas):
    stage = DATA / "marketplace.new"
    if stage.exists():
        shutil.rmtree(stage)
    stage.mkdir(parents=True)
    built = [
        build_pstack(stage, shas["pstack"]),
        build_mattpocock(stage, shas["mattpocock"]),
        build_karpathy(stage, shas["karpathy"]),
        build_router(stage),
    ]
    (stage / ".claude-plugin").mkdir()
    (stage / ".claude-plugin/marketplace.json").write_text(json.dumps({
        "name": MARKETPLACE,
        "description": "Local Claude Code builds of pstack, Matt Pocock's skills and the"
                       " Karpathy guidelines, with a skill router.",
        "owner": {"name": "skillstack"},
        "plugins": [{"name": meta["name"], "source": "./" + meta["name"],
                     "version": meta["version"], "description": meta["description"]}
                    for meta, _ in built],
    }, indent=2) + "\n")

    if MARKET.exists():
        shutil.rmtree(MARKET)
    stage.rename(MARKET)
    for meta, count in built:
        print("built {} {} ({} skills)".format(meta["name"], meta["version"], count), flush=True)
    return [meta["name"] for meta, _ in built]


def install(plugins):
    if not shutil.which("claude"):
        die("claude is not on PATH")
    run("claude", "plugin", "validate", str(MARKET))
    known = run("claude", "plugin", "marketplace", "list", capture=True).stdout
    if re.search(r"❯ {}\s".format(MARKETPLACE), known):
        run("claude", "plugin", "marketplace", "update", MARKETPLACE)
    else:
        run("claude", "plugin", "marketplace", "add", str(MARKET))
    installed = run("claude", "plugin", "list", capture=True).stdout
    for name in plugins:
        ident = "{}@{}".format(name, MARKETPLACE)
        run("claude", "plugin", "update" if ident in installed else "install", ident)
    print("installed {} from {}. New Claude sessions pick them up.".format(
        ", ".join(plugins), MARKETPLACE))


def parse_refs(pairs):
    refs = {name: "main" for name in SOURCES}
    for pair in pairs:
        name, sep, ref = pair.partition("=")
        if not sep or name not in SOURCES or not ref:
            die("--ref takes NAME=REF with NAME one of {}".format(", ".join(SOURCES)))
        refs[name] = ref
    return refs


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--ref", action="append", default=[], metavar="NAME=REF",
                        help="build source NAME at an upstream branch, tag or commit")
    parser.add_argument("--build", action="store_true", help="build only, do not install")
    args = parser.parse_args()
    refs = parse_refs(args.ref)
    plugins = build({name: fetch(name, ref) for name, ref in refs.items()})
    if not args.build:
        install(plugins)


if __name__ == "__main__":
    main()
