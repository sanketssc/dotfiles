#!/usr/bin/env bash
# Import atuin's shell history (incl. everything imported from zsh) into nushell's own history,
# so nu's inline hints and up-arrow know it too. atuin itself already serves ctrl+r in nu.
# Idempotent: commands already in nu's history (same start time to the ms + same command) are skipped,
# so it also fills in OLDER history merged into atuin later.
set -euo pipefail
DB="${1:-${XDG_DATA_HOME:-$HOME/.local/share}/atuin/history.db}"
NU_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nushell"
[[ -f "$DB" ]] || { echo "no atuin db at $DB"; exit 1; }
exec nu --config "$NU_DIR/config.nu" --env-config "$NU_DIR/env.nu" -c "
let have = (try { history | each {|h| \$'(\$h.start_timestamp | into int | \$in // 1_000_000)|(\$h.command)'} } catch { [] })
let rows = (open '$DB'
  | query db 'select command, timestamp, duration, exit, cwd, hostname from history where deleted_at is null order by timestamp'
  | where {|r| \$'(\$r.timestamp // 1_000_000)|(\$r.command)' not-in \$have})
\$rows | each {|r| {
    command: \$r.command,
    start_timestamp: (\$r.timestamp | into datetime),
    duration: (if \$r.duration > 0 { \$r.duration | into duration } else { 0sec }),
    exit_status: \$r.exit, cwd: \$r.cwd, hostname: \$r.hostname
  }} | history import
print \$'imported (\$rows | length) commands into (\$nu.history-path)'
"
